{
    # Azure App Service and other front ends may terminate TLS before Caddy.
    # Trust private proxy hops so X-Forwarded-* headers from the edge are kept.
    servers {
        trusted_proxies private_ranges
    }
}

localhost {
    tls internal
    import caddy.oauth2.conf
}

:80 {
    import caddy.oauth2.conf
}
