# Cookie secret (must be 16, 24, or 32 bytes)
OAUTH2_PROXY_COOKIE_SECRET=OvOKIsRzvMvLC2a5a1v3KyepFrECq6v1

# Upstream
OAUTH2_PROXY_UPSTREAMS=static://202

# Azure / OIDC — using "common" to support personal Microsoft accounts
OAUTH2_PROXY_PROVIDER=azure
OAUTH2_PROXY_AZURE_TENANT=52143a51-7e71-4bc0-85c5-509e856bf154
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/52143a51-7e71-4bc0-85c5-509e856bf154/v2.0
OAUTH2_PROXY_EXTRA_JWT_ISSUERS=https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/v2.0=d66d3b46-be15-45da-8295-fec21769eabe
OAUTH2_PROXY_INSECURE_OIDC_SKIP_ISSUER_VERIFICATION=true
OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL=true

# App registration
OAUTH2_PROXY_CLIENT_ID=d66d3b46-be15-45da-8295-fec21769eabe
OAUTH2_PROXY_CLIENT_SECRET=KOQ8Q~gtIO9baiAMniBevOIenAAtURrtepqiecg0
OAUTH2_PROXY_SCOPE=openid email profile offline_access

# Callback
OAUTH2_PROXY_REDIRECT_URL=https://localhost/oauth2/callback
OAUTH2_PROXY_EMAIL_DOMAINS=*

# Cookies
OAUTH2_PROXY_COOKIE_NAME=_oauth2_proxy
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_DOMAIN=localhost

# Headers
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=false

# Redis session store
OAUTH2_PROXY_SESSION_STORE_TYPE=redis
OAUTH2_PROXY_REDIS_CONNECTION_URL=redis://redis:6379


# Logging
OAUTH2_PROXY_REQUEST_LOGGING=true
OAUTH2_PROXY_LOG_LEVEL=debug
