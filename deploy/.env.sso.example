# Copy to .env and fill values.
# Used by docker-compose for oauth2-proxy + Caddy auth routing.

# Your public domain.
# Keep this as the single source of truth: the redirect URL and cookie domain
# below should always match this host exactly.
CADDY_DOMAIN=awareness.example.com

# Azure AD / Entra ID
OAUTH2_PROXY_PROVIDER=azure
# If using azure, oauth2-proxy expects these (typical):
# https://oauth2-proxy.github.io/oauth2-proxy/configuration/oauth2-proxy.html
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Issuer/discovery URL. For Azure it is usually:
# https://login.microsoftonline.com/<TENANT_ID>/v2.0
OAUTH2_PROXY_OIDC_ISSUER_URL=

# Cookie/session
# Must be 16/32/64 bytes base64-ish string; generate one securely.
OAUTH2_PROXY_COOKIE_SECRET=
# Must be true when the public site is served over HTTPS.
OAUTH2_PROXY_COOKIE_SECURE=true
# Required when oauth2-proxy sits behind Caddy or Azure App Service.
OAUTH2_PROXY_REVERSE_PROXY=true
# Needed if Caddy forwards X-Auth-Request-* headers to the app.
OAUTH2_PROXY_SET_XAUTHREQUEST=true

# Allowlist (recommended) — set either domain allow or group allow.
# Example: "contoso.com"
OAUTH2_PROXY_EMAIL_DOMAINS=

# Redirect URI. Usually matches your domain + oauth2-proxy callback path.
# oauth2-proxy default callback path is /oauth2/callback.
OAUTH2_PROXY_REDIRECT_URL=https://awareness.example.com/oauth2/callback

# Cookie domain. Must match CADDY_DOMAIN exactly so the browser keeps the
# oauth2-proxy session across refreshes and page-to-page navigation.
OAUTH2_PROXY_COOKIE_DOMAIN=awareness.example.com

